                pin-requested => { root.item-pin-requested(1); }
            }
            ClipboardRow {
                item-title: root.item-3-title;
                item-subtitle: root.item-3-subtitle;
                item-visible: root.item-3-visible;
                item-pinned: root.item-3-pinned;
