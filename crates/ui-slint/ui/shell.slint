    in-out property <string> item-2-title: "";
    in-out property <string> item-2-subtitle: "";
    in-out property <bool> item-2-visible: false;
    in-out property <bool> item-2-pinned: false;
    in-out property <bool> item-2-copyable: false;
    in-out property <string> item-3-title: "";
    in-out property <string> item-3-subtitle: "";
    in-out property <bool> item-3-visible: false;
    in-out property <bool> item-3-pinned: false;
    in-out property <bool> item-3-copyable: false;
    in-out property <string> item-4-title: "";
    in-out property <string> item-4-subtitle: "";
    in-out property <bool> item-4-visible: false;
    in-out property <bool> item-4-pinned: false;
    in-out property <bool> item-4-copyable: false;
    in-out property <string> item-5-title: "";
    in-out property <string> item-5-subtitle: "";
    in-out property <bool> item-5-visible: false;
    in-out property <bool> item-5-pinned: false;
    in-out property <bool> item-5-copyable: false;
    in-out property <string> item-6-title: "";
    in-out property <string> item-6-subtitle: "";
    in-out property <bool> item-6-visible: false;
    in-out property <bool> item-6-pinned: false;
    in-out property <bool> item-6-copyable: false;
    in-out property <string> item-7-title: "";
    in-out property <string> item-7-subtitle: "";
    in-out property <bool> item-7-visible: false;
    in-out property <bool> item-7-pinned: false;
    in-out property <bool> item-7-copyable: false;
    in-out property <string> item-8-title: "";
    in-out property <string> item-8-subtitle: "";
    in-out property <bool> item-8-visible: false;
    in-out property <bool> item-8-pinned: false;
    in-out property <bool> item-8-copyable: false;
    callback filter-requested();
    callback item-activated(int);
    callback item-copy-requested(int);
    callback item-pin-requested(int);
    callback clear-requested();
    callback pause-requested();
    callback dismiss-requested();

    width: 880px;
    height: 760px;
    title: "Clipboard History";

    VerticalBox {
        padding: 24px;
        spacing: 12px;

        HorizontalBox {
            height: 36px;
            spacing: 8px;
            Text {
                width: 180px;
                text: "Clipboard History";
                font-size: 20px;
                vertical-alignment: center;
                accessible-label: "Clipboard history";
            }
            Button {
                width: 160px;
                text: root.filter-label;
                accessible-label: "Change clipboard type filter";
                clicked => { root.filter-requested(); }
            }
            Button {
                width: 120px;
                text: root.paused ? "Resume" : "Pause";
                accessible-label: root.paused ? "Resume clipboard capture" : "Pause clipboard capture";
                clicked => { root.pause-requested(); }
            }
            Button {
                width: 120px;
                text: "Clear all";
                accessible-label: "Clear clipboard history";
                clicked => { root.clear-requested(); }
            }
        }

        VerticalBox {
            height: 368px;
            spacing: 4px;
            ClipboardRow {
                item-title: root.item-1-title;
                item-subtitle: root.item-1-subtitle;
                item-visible: root.item-1-visible;
                item-pinned: root.item-1-pinned;
                item-copyable: root.item-1-copyable;
                activated => { root.item-activated(0); }
