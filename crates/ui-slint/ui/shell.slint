                        field-error: root.plugin-field-6-error;
                        field-options: root.plugin-field-6-options;
                        field-option-index <=> root.plugin-field-6-option-index;
                        field-value <=> root.plugin-field-6-value;
                        value-edited(value) => { root.plugin-form-value-changed(5, value); }
                    }

                    Button {
                        visible: root.plugin-view-kind == "form";
                        text: "Submit";
                        accessible-label: "Submit plugin form";
                        clicked => { root.plugin-form-submit-requested(); }
                    }

                    PluginActionButton {
                        action-title: root.plugin-action-1-title;
                        action-visible: root.plugin-action-1-visible;
                        activated => { root.plugin-action-requested(0); }
                    }
                    PluginActionButton {
                        action-title: root.plugin-action-2-title;
                        action-visible: root.plugin-action-2-visible;
                        activated => { root.plugin-action-requested(1); }
                    }
                    PluginActionButton {
                        action-title: root.plugin-action-3-title;
                        action-visible: root.plugin-action-3-visible;
                        activated => { root.plugin-action-requested(2); }
                    }
                    PluginActionButton {
                        action-title: root.plugin-action-4-title;
                        action-visible: root.plugin-action-4-visible;
                        activated => { root.plugin-action-requested(3); }
                    }
                    PluginActionButton {
                        action-title: root.plugin-action-5-title;
