import {
    Button,
    CheckBox,
    ComboBox,
    HorizontalBox,
    LineEdit,
    ProgressIndicator,
    Switch,
    VerticalBox,
} from "std-widgets.slint";

component PluginItemRow inherits HorizontalBox {
    in property <string> item-title;
    in property <string> item-subtitle;
    in property <string> item-status;
    in property <string> item-badge;
    in property <string> item-shortcut;
    in property <string> item-icon-id;
    in property <bool> item-visible;
    in property <bool> dark-theme;
    callback activated();

    visible: item-visible;
    height: 32px;
    spacing: 8px;

    Button {
        width: 180px;
        text: root.item-title;
        accessible-label: root.item-title;
        clicked => { root.activated(); }
    }

    Text {
        vertical-alignment: center;
        text: root.item-subtitle;
        color: root.dark-theme ? #9bb9e8 : #4e6280;
        overflow: elide;
        accessible-label: "Plugin item description";
    }

    Text {
        visible: root.item-status != "";
        vertical-alignment: center;
        text: root.item-status;
        color: root.dark-theme ? #c8d8f2 : #52657f;
        overflow: elide;
        accessible-label: "Plugin item status";
    }

    Text {
        visible: root.item-badge != "";
        vertical-alignment: center;
        text: "[" + root.item-badge + "]";
        color: root.dark-theme ? #9ed8b0 : #26734d;
        overflow: elide;
        accessible-label: "Plugin item badge";
    }

    Text {
        visible: root.item-shortcut != "";
        vertical-alignment: center;
        text: root.item-shortcut;
        color: root.dark-theme ? #d5c2ff : #5b3c99;
        overflow: elide;
        accessible-label: "Plugin item shortcut";
    }

    Text {
        visible: root.item-icon-id != "";
        vertical-alignment: center;
        text: "◆";
        accessible-label: "Plugin item icon resource";
    }
}

component PluginFieldRow inherits HorizontalBox {
    in property <string> field-label;
    in property <string> field-kind;
    in property <bool> field-required;
    in property <bool> field-visible;
    in property <bool> dark-theme;
    in property <string> field-helper;
    in property <string> field-error;
    in property <[string]> field-options;
    in-out property <int> field-option-index;
    in-out property <string> field-value;
    callback value-edited(string);

    visible: field-visible;
    height: 34px;
    spacing: 8px;

    Text {
        width: 180px;
        vertical-alignment: center;
        text: root.field-label
            + (root.field-required ? " *" : "")
            + (root.field-error != ""
                ? " - " + root.field-error
                : (root.field-helper != "" ? " - " + root.field-helper : ""));
        color: root.field-error != ""
            ? (root.dark-theme ? #ff9c9c : #b42318)
            : (root.dark-theme ? #f5f7fa : #17191c);
        overflow: elide;
        accessible-label: root.field-label;
    }

    LineEdit {
        visible: root.field-kind == "text" || root.field-kind == "password";
        text <=> root.field-value;
        input-type: root.field-kind == "password" ? InputType.password : InputType.text;
        placeholder-text: root.field-label;
        accessible-label: root.field-label;
        edited => { root.value-edited(self.text); }
    }

    ComboBox {
        visible: root.field-kind == "select";
        model: root.field-options;
        current-index <=> root.field-option-index;
        accessible-label: root.field-label;
        selected(value) => { root.value-edited(value); }
    }

    CheckBox {
        visible: root.field-kind == "checkbox";
        text: "Enabled";
        checked: root.field-value == "true";
        accessible-label: root.field-label;
        toggled => {
            root.field-value = self.checked ? "true" : "false";
            root.value-edited(root.field-value);
        }
    }

    Switch {
        visible: root.field-kind == "switch";
        text: "Enabled";
        checked: root.field-value == "true";
        accessible-label: root.field-label;
        toggled => {
            root.field-value = self.checked ? "true" : "false";
            root.value-edited(root.field-value);
        }
    }
}

component PluginActionButton inherits Button {
    in property <string> action-title;
    in property <bool> action-visible;
    callback activated();

    visible: action-visible;
    text: root.action-title;
    accessible-label: root.action-title;
    clicked => { root.activated(); }
}

component SearchResultRow inherits Rectangle {
    in property <string> result-title;
    in property <string> result-subtitle;
    in property <bool> result-visible;
    in property <bool> result-selected;
    in property <bool> dark-theme;
    callback activated();

    visible: result-visible;
    height: 44px;
    background: result-selected
        ? (root.dark-theme ? #25364f : #e8f1ff)
        : (root.dark-theme ? #202327 : #ffffff);
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.result-title + ", " + root.result-subtitle;

    Text {
        x: 12px;
        y: 5px;
        width: 420px;
        height: 18px;
        text: root.result-title;
        color: root.dark-theme ? #f5f7fa : #17191c;
        overflow: elide;
        accessible-label: root.result-title;
    }

    Text {
        x: 12px;
        y: 24px;
        width: 600px;
        height: 15px;
        text: root.result-subtitle;
        color: root.dark-theme ? #aeb5bf : #5e6670;
        font-size: 12px;
        overflow: elide;
        accessible-label: root.result-subtitle;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

component ActionPanelRow inherits Button {
    in property <string> action-title;
    in property <bool> action-visible;
    callback activated();

    visible: action-visible;
    text: root.action-title;
    accessible-label: root.action-title;
    clicked => { root.activated(); }
}

component ClipboardRow inherits HorizontalBox {
    in property <string> item-title;
    in property <string> item-subtitle;
    in property <bool> item-visible;
    in property <bool> item-pinned;
    in property <bool> item-copyable;
    callback activated();
    callback copy-requested();
    callback pin-requested();

    visible: item-visible;
    height: 42px;
    spacing: 8px;

    Button {
        width: 420px;
        text: root.item-title;
        accessible-label: root.item-title + ", " + root.item-subtitle;
        clicked => { root.activated(); }
    }

    Button {
        width: 80px;
        text: root.item-pinned ? "Unpin" : "Pin";
        accessible-label: root.item-pinned ? "Unpin clipboard item" : "Pin clipboard item";
        clicked => { root.pin-requested(); }
    }

    Button {
        width: 80px;
        enabled: root.item-copyable;
        text: root.item-copyable ? "Copy" : "Preview";
        accessible-label: root.item-copyable ? "Copy clipboard item" : "Clipboard image preview unavailable";
        clicked => { root.copy-requested(); }
    }
}

