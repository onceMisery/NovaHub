                    }
                    PluginActionButton {
                        action-title: root.plugin-action-6-title;
                        action-visible: root.plugin-action-6-visible;
                        activated => { root.plugin-action-requested(5); }
                    }
                }
            }

            Button {
                text: "Run";
                accessible-label: "Run selected command";
                clicked => { root.run-requested(); }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    in-out property <bool> dark-theme: false;
    in-out property <string> theme: "system";
    in-out property <string> hotkey: "";
    in-out property <string> clipboard-ttl: "604800";
    in-out property <string> clipboard-limit: "500";
    in-out property <string> status-text: "";
    callback settings-save-requested();
    callback settings-dismiss-requested();

    width: 920px;
    height: 640px;
    title: "NovaHub Settings";

    HorizontalBox {
        Rectangle {
            width: 220px;
            background: #202327;

            VerticalBox {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Settings";
                    color: #f5f7fa;
                    font-size: 20px;
                    accessible-label: "NovaHub settings";
                }
                Text {
                    text: "General";
                    color: #aeb5bf;
                    accessible-label: "General settings section";
                }
                Text {
                    text: "Privacy";
                    color: #aeb5bf;
                    accessible-label: "Privacy settings section";
                }
            }
        }

        Rectangle {
            background: root.dark-theme ? #151719 : #f4f5f7;

            VerticalBox {
                padding: 32px;
                spacing: 16px;

                Text {
                    text: "General";
                    color: root.dark-theme ? #f5f7fa : #17191c;
                    font-size: 20px;
                    accessible-label: "General settings";
                }

                Text {
                    text: "Theme (system, light, or dark)";
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    accessible-label: "Theme setting label";
                }
                LineEdit {
                    text <=> root.theme;
                    placeholder-text: "system";
                    accessible-label: "Theme value";
                }

                Text {
                    text: "Global shortcut";
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    accessible-label: "Global shortcut setting label";
                }
                LineEdit {
                    text <=> root.hotkey;
                    placeholder-text: "Alt+Space";
                    accessible-label: "Global shortcut value";
                }

                Text {
                    text: "Clipboard retention (seconds)";
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    accessible-label: "Clipboard retention setting label";
                }
                LineEdit {
                    text <=> root.clipboard-ttl;
                    placeholder-text: "604800";
                    accessible-label: "Clipboard retention value";
                }

                Text {
                    text: "Clipboard item limit";
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    accessible-label: "Clipboard item limit setting label";
                }
                LineEdit {
                    text <=> root.clipboard-limit;
                    placeholder-text: "500";
                    accessible-label: "Clipboard item limit value";
                }

                Text {
                    text: root.status-text;
                    color: root.dark-theme ? #f2b35b : #a45a00;
                    accessible-label: "Settings status";
                }

                HorizontalBox {
                    spacing: 12px;
                    Button {
                        text: "Save";
                        accessible-label: "Save settings";
                        clicked => { root.settings-save-requested(); }
                    }
                    Button {
                        text: "Cancel";
                        accessible-label: "Cancel settings";
                        clicked => { root.settings-dismiss-requested(); }
                    }
                }
            }
        }
    }
}

export component ClipboardWindow inherits Window {
    in-out property <string> filter-label: "All";
