    in-out property <bool> plugin-field-6-visible: false;
    in-out property <string> plugin-field-6-helper: "";
    in-out property <string> plugin-field-6-error: "";
    in-out property <[string]> plugin-field-6-options: [];
    in-out property <int> plugin-field-6-option-index: 0;
    in-out property <string> plugin-field-6-value: "";
    in-out property <string> plugin-action-1-title: "";
    in-out property <bool> plugin-action-1-visible: false;
    in-out property <string> plugin-action-2-title: "";
    in-out property <bool> plugin-action-2-visible: false;
    in-out property <string> plugin-action-3-title: "";
    in-out property <bool> plugin-action-3-visible: false;
    in-out property <string> plugin-action-4-title: "";
    in-out property <bool> plugin-action-4-visible: false;
    in-out property <string> plugin-action-5-title: "";
    in-out property <bool> plugin-action-5-visible: false;
    in-out property <string> plugin-action-6-title: "";
    in-out property <bool> plugin-action-6-visible: false;
    in-out property <bool> plugin-default-action-visible: false;
    callback query-changed(string);
    callback run-requested();
    callback selection-moved(int);
    callback result-row-activated(int);
    callback action-panel-requested();
    callback action-panel-dismiss-requested();
    callback action-panel-action-requested(int);
    callback dismiss-requested();
    callback shell-focus-lost();
    callback focus-search-requested();
    callback settings-requested();
    callback clipboard-history-requested();
    callback provider-filter-requested();
    callback plugin-item-activated(int);
    callback plugin-list-previous-requested();
    callback plugin-list-next-requested();
    callback plugin-action-requested(int);
    callback plugin-default-action-requested();
    callback plugin-form-value-changed(int, string);
    callback plugin-form-submit-requested();
    callback diagnostics-preview-requested();
    callback diagnostics-filter-requested();
    callback diagnostics-clear-requested();
    callback diagnostics-export-requested();

    focus-search-requested => { search-input.focus(); }

    width: 720px;
    height: 620px;
    title: "NovaHub";
    background: root.dark-theme ? #151719 : #f4f5f7;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.selection-moved(-1);
                accept
            } else if (event.text == Key.DownArrow) {
                root.selection-moved(1);
                accept
            } else if ((event.text == "k" || event.text == "K")
                && (event.modifiers.control || event.modifiers.meta)) {
                root.action-panel-requested();
                accept
            } else if (event.text == ","
                && (event.modifiers.control || event.modifiers.meta)) {
                root.settings-requested();
                accept
            } else if ((event.text == "p" || event.text == "P")
                && (event.modifiers.control || event.modifiers.meta)) {
                root.provider-filter-requested();
                accept
            } else if (event.text == Key.Escape) {
                if (root.action-panel-visible) {
                    root.action-panel-dismiss-requested();
                } else {
                    root.dismiss-requested();
                }
                accept
            }
            reject
        }

        focus-lost(_reason) => { root.shell-focus-lost(); }

        VerticalBox {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "NovaHub";
                color: root.dark-theme ? #f5f7fa : #17191c;
                accessible-label: "NovaHub command launcher";
            }

            search-input := LineEdit {
                text <=> root.query-text;
                placeholder-text: "Search all capabilities";
                accessible-label: "Search all capabilities";
                edited => { root.query-changed(self.text); }
                accepted => {
                    if (root.plugin-view-kind == "action_panel"
                        && root.plugin-default-action-visible) {
                        root.plugin-default-action-requested();
                    } else {
                        root.run-requested();
                    }
                }
            }

            HorizontalBox {
                height: 30px;
                spacing: 8px;

                Text {
                    width: 110px;
                    vertical-alignment: center;
                    text: "Provider";
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    accessible-label: "Provider filter";
                }

                Button {
                    width: 220px;
                    text: root.provider-filter-label;
                    accessible-label: "Change provider filter";
                    clicked => { root.provider-filter-requested(); }
                }
            }

            VerticalBox {
                visible: root.result-list-visible;
                height: 380px;
                spacing: 4px;

                SearchResultRow {
                    result-title: root.result-1-title;
                    result-subtitle: root.result-1-subtitle;
                    result-visible: root.result-1-visible;
                    result-selected: root.result-1-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(0); }
                }
                SearchResultRow {
                    result-title: root.result-2-title;
                    result-subtitle: root.result-2-subtitle;
                    result-visible: root.result-2-visible;
                    result-selected: root.result-2-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(1); }
                }
                SearchResultRow {
                    result-title: root.result-3-title;
                    result-subtitle: root.result-3-subtitle;
                    result-visible: root.result-3-visible;
                    result-selected: root.result-3-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(2); }
                }
                SearchResultRow {
                    result-title: root.result-4-title;
                    result-subtitle: root.result-4-subtitle;
                    result-visible: root.result-4-visible;
                    result-selected: root.result-4-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(3); }
                }
                SearchResultRow {
                    result-title: root.result-5-title;
                    result-subtitle: root.result-5-subtitle;
                    result-visible: root.result-5-visible;
                    result-selected: root.result-5-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(4); }
                }
                SearchResultRow {
                    result-title: root.result-6-title;
                    result-subtitle: root.result-6-subtitle;
                    result-visible: root.result-6-visible;
                    result-selected: root.result-6-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(5); }
                }
                SearchResultRow {
                    result-title: root.result-7-title;
                    result-subtitle: root.result-7-subtitle;
                    result-visible: root.result-7-visible;
                    result-selected: root.result-7-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(6); }
                }
                SearchResultRow {
                    result-title: root.result-8-title;
                    result-subtitle: root.result-8-subtitle;
                    result-visible: root.result-8-visible;
                    result-selected: root.result-8-selected;
                    dark-theme: root.dark-theme;
                    activated => { root.result-row-activated(7); }
                }
            }

            Rectangle {
                visible: root.action-panel-visible;
                height: 116px;
                background: root.dark-theme ? #202327 : #ffffff;
                border-radius: 6px;
                accessible-role: groupbox;
                accessible-label: root.action-panel-title;

                Text {
                    x: 12px;
                    y: 8px;
                    width: 620px;
                    height: 20px;
                    text: root.action-panel-title;
                    color: root.dark-theme ? #f5f7fa : #17191c;
                    font-size: 14px;
                    overflow: elide;
                }

                Text {
                    x: 12px;
                    y: 29px;
                    width: 620px;
                    height: 18px;
                    text: root.action-panel-description;
                    color: root.dark-theme ? #aeb5bf : #5e6670;
                    font-size: 12px;
                    overflow: elide;
                }

                ActionPanelRow {
                    x: 12px;
                    y: 53px;
                    width: 296px;
                    height: 34px;
                    action-title: root.action-panel-1-title;
                    action-visible: root.action-panel-1-visible;
                    activated => { root.action-panel-action-requested(0); }
                }

                ActionPanelRow {
                    x: 316px;
                    y: 53px;
                    width: 296px;
                    height: 34px;
                    action-title: root.action-panel-2-title;
                    action-visible: root.action-panel-2-visible;
                    activated => { root.action-panel-action-requested(1); }
                }
            }

            Text {
                visible: !root.result-list-visible;
                text: root.result-text;
                color: root.dark-theme ? #aeb5bf : #5e6670;
                accessible-label: "Search results";
            }

            Text {
                text: root.status-text;
                color: root.dark-theme ? #aeb5bf : #5e6670;
                accessible-label: "Command status";
            }

            Rectangle {
                height: 300px;
                visible: root.plugin-view-kind != "";
                background: root.dark-theme ? #202a3b : #eef3fb;
                border-radius: 6px;

                VerticalBox {
                    x: 12px;
                    y: 8px;
                    width: 648px;
                    height: 284px;
                    spacing: 5px;

                    Text {
                        height: 22px;
                        text: root.plugin-view-title;
                        font-size: 16px;
                        color: root.dark-theme ? #f5f7fa : #17243a;
                        overflow: elide;
                        accessible-label: "Plugin view title";
                    }

                    Text {
                        height: 18px;
                        text: root.plugin-view-kind;
                        font-size: 11px;
                        color: root.dark-theme ? #9bb9e8 : #4e6280;
                        overflow: elide;
                        accessible-label: "Plugin view kind";
                    }

                    Text {
                        height: 58px;
                        visible: root.plugin-view-kind == "empty"
                            || root.plugin-view-kind == "detail"
                            || root.plugin-view-kind == "loading"
                            || root.plugin-view-kind == "progress"
                            || root.plugin-view-kind == "error"
                            || root.plugin-view-kind == "unknown";
                        text: root.plugin-view-body;
                        color: root.dark-theme ? #d7e3f7 : #25334b;
                        wrap: word-wrap;
                        overflow: elide;
                        accessible-label: "Plugin view content";
                    }

                    ProgressIndicator {
                        visible: root.plugin-view-kind == "progress";
                        progress: root.plugin-progress;
                        indeterminate: false;
                        accessible-label: "Plugin progress";
                    }

                    Text {
                        height: 190px;
                        visible: root.plugin-view-kind == "diagnostics";
                        text: root.plugin-view-body;
                        color: root.dark-theme ? #d7e3f7 : #25334b;
                        wrap: word-wrap;
                        overflow: elide;
                        accessible-label: "Diagnostic preview";
                    }

                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-1-title;
                        item-subtitle: root.plugin-item-1-subtitle;
                        item-status: root.plugin-item-1-status;
                        item-badge: root.plugin-item-1-badge;
                        item-shortcut: root.plugin-item-1-shortcut;
                        item-icon-id: root.plugin-item-1-icon-id;
                        item-visible: root.plugin-item-1-visible;
                        activated => { root.plugin-item-activated(0); }
                    }
                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-2-title;
                        item-subtitle: root.plugin-item-2-subtitle;
                        item-status: root.plugin-item-2-status;
                        item-badge: root.plugin-item-2-badge;
                        item-shortcut: root.plugin-item-2-shortcut;
                        item-icon-id: root.plugin-item-2-icon-id;
                        item-visible: root.plugin-item-2-visible;
                        activated => { root.plugin-item-activated(1); }
                    }
                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-3-title;
                        item-subtitle: root.plugin-item-3-subtitle;
                        item-status: root.plugin-item-3-status;
                        item-badge: root.plugin-item-3-badge;
                        item-shortcut: root.plugin-item-3-shortcut;
                        item-icon-id: root.plugin-item-3-icon-id;
                        item-visible: root.plugin-item-3-visible;
                        activated => { root.plugin-item-activated(2); }
                    }
                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-4-title;
                        item-subtitle: root.plugin-item-4-subtitle;
                        item-status: root.plugin-item-4-status;
                        item-badge: root.plugin-item-4-badge;
                        item-shortcut: root.plugin-item-4-shortcut;
                        item-icon-id: root.plugin-item-4-icon-id;
                        item-visible: root.plugin-item-4-visible;
                        activated => { root.plugin-item-activated(3); }
                    }
                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-5-title;
                        item-subtitle: root.plugin-item-5-subtitle;
                        item-status: root.plugin-item-5-status;
                        item-badge: root.plugin-item-5-badge;
                        item-shortcut: root.plugin-item-5-shortcut;
                        item-icon-id: root.plugin-item-5-icon-id;
                        item-visible: root.plugin-item-5-visible;
                        activated => { root.plugin-item-activated(4); }
                    }
                    PluginItemRow {
                        dark-theme: root.dark-theme;
                        item-title: root.plugin-item-6-title;
                        item-subtitle: root.plugin-item-6-subtitle;
                        item-status: root.plugin-item-6-status;
                        item-badge: root.plugin-item-6-badge;
                        item-shortcut: root.plugin-item-6-shortcut;
                        item-icon-id: root.plugin-item-6-icon-id;
                        item-visible: root.plugin-item-6-visible;
                        activated => { root.plugin-item-activated(5); }
                    }

                    HorizontalBox {
                        height: 34px;
                        spacing: 8px;
                        visible: root.plugin-view-kind == "list"
                            || root.plugin-view-kind == "grid";

                        Button {
                            width: 120px;
                            enabled: root.plugin-list-previous-visible;
                            text: "< Previous";
                            accessible-label: "Previous plugin items";
                            clicked => { root.plugin-list-previous-requested(); }
                        }

                        Button {
                            width: 120px;
                            enabled: root.plugin-list-next-visible;
                            text: root.plugin-list-next-loads-more ? "Load more >" : "Next >";
                            accessible-label: root.plugin-list-next-loads-more
                                ? "Load more plugin items"
                                : "Next plugin items";
                            clicked => { root.plugin-list-next-requested(); }
                        }
                    }

                    HorizontalBox {
                        height: 34px;
                        spacing: 8px;
                        visible: root.plugin-view-kind == "diagnostics";

                        Button {
                            width: 120px;
                            text: "Preview";
                            accessible-label: "Preview diagnostics";
                            clicked => { root.diagnostics-preview-requested(); }
                        }

                        Button {
                            width: 160px;
                            text: root.diagnostics-failures-only
                                ? "Show all events"
                                : "Failures only";
                            accessible-label: root.diagnostics-failures-only
                                ? "Show all diagnostic events"
                                : "Show diagnostic failures only";
                            clicked => { root.diagnostics-filter-requested(); }
                        }

                        Button {
                            width: 100px;
                            text: "Clear";
                            accessible-label: "Clear diagnostics";
                            clicked => { root.diagnostics-clear-requested(); }
                        }

                        Button {
                            width: 100px;
                            text: "Export";
                            accessible-label: "Export diagnostics";
                            clicked => { root.diagnostics-export-requested(); }
                        }
                    }

                    PluginFieldRow {
                        dark-theme: root.dark-theme;
                        field-label: root.plugin-field-1-label;
                        field-kind: root.plugin-field-1-kind;
                        field-required: root.plugin-field-1-required;
                        field-visible: root.plugin-field-1-visible;
                        field-helper: root.plugin-field-1-helper;
                        field-error: root.plugin-field-1-error;
                        field-options: root.plugin-field-1-options;
                        field-option-index <=> root.plugin-field-1-option-index;
                        field-value <=> root.plugin-field-1-value;
                        value-edited(value) => { root.plugin-form-value-changed(0, value); }
                    }
                    PluginFieldRow {
                        dark-theme: root.dark-theme;
                        field-label: root.plugin-field-2-label;
                        field-kind: root.plugin-field-2-kind;
                        field-required: root.plugin-field-2-required;
                        field-visible: root.plugin-field-2-visible;
                        field-helper: root.plugin-field-2-helper;
                        field-error: root.plugin-field-2-error;
