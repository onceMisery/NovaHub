                        field-option-index <=> root.plugin-field-4-option-index;
                        field-value <=> root.plugin-field-4-value;
                        value-edited(value) => { root.plugin-form-value-changed(3, value); }
                    }
                    PluginFieldRow {
                        dark-theme: root.dark-theme;
                        field-label: root.plugin-field-5-label;
                        field-kind: root.plugin-field-5-kind;
                        field-required: root.plugin-field-5-required;
                        field-visible: root.plugin-field-5-visible;
                        field-helper: root.plugin-field-5-helper;
                        field-error: root.plugin-field-5-error;
                        field-options: root.plugin-field-5-options;
