export component PetWindow inherits Window {
    in-out property <string> pet-label: "N";
    in-out property <string> frame-asset: "builtin://nova/idle";
    in-out property <image> pet-image;
    in-out property <bool> shelf-visible: false;
    in-out property <string> shelf-label: "No pinned actions";
    in-out property <string> shelf-action-1: "";
    in-out property <string> shelf-action-2: "";
    in-out property <string> shelf-action-3: "";
    in-out property <string> shelf-action-4: "";
    in-out property <string> shelf-action-5: "";
    in-out property <bool> shelf-action-1-visible: false;
    in-out property <bool> shelf-action-2-visible: false;
    in-out property <bool> shelf-action-3-visible: false;
    in-out property <bool> shelf-action-4-visible: false;
    in-out property <bool> shelf-action-5-visible: false;
    callback pet-clicked();
    callback shelf-action-clicked(int);
    callback pet-drag-started();
    callback pet-drag-moved(length, length);
    callback pet-drag-ended();

    width: 360px;
    height: 160px;
    title: "NovaHub Pet";
    background: transparent;
    no-frame: true;
    always-on-top: true;
    resize-border-width: 0px;

    Rectangle {
        x: 12px;
        y: 12px;
        width: 72px;
        height: 72px;
        border-radius: 36px;
        background: #2f6fed;

        Image {
            width: 72px;
            height: 72px;
            source: root.pet-image;
            image-fit: contain;
            accessible-label: "NovaHub pet artwork";
        }

        Text {
            width: 72px;
            height: 72px;
            text: root.pet-label;
            color: white;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-label: "NovaHub desktop pet";
        }

        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        root.pet-drag-started();
                    } else if (event.kind == PointerEventKind.move) {
                        root.pet-drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    } else if (event.kind == PointerEventKind.up) {
                        root.pet-drag-ended();
                    }
                }
            }
            clicked => { root.pet-clicked(); }
        }
    }

    Rectangle {
        x: 4px;
        y: 82px;
        width: 344px;
        height: 62px;
        visible: root.shelf-visible;
        background: #202a3b;
        border-radius: 6px;

        Text {
            x: 6px;
            y: 4px;
            width: 140px;
            height: 20px;
            text: root.shelf-label;
            color: white;
            font-size: 11px;
            overflow: elide;
            accessible-label: "Pet action shelf";
        }

        Button {
            x: 6px;
            y: 30px;
            width: 62px;
            height: 24px;
            visible: root.shelf-action-1-visible;
            text: root.shelf-action-1;
            clicked => { root.shelf-action-clicked(0); }
        }

        Button {
            x: 74px;
            y: 30px;
            width: 62px;
            height: 24px;
            visible: root.shelf-action-2-visible;
            text: root.shelf-action-2;
            clicked => { root.shelf-action-clicked(1); }
        }

        Button {
            x: 142px;
            y: 30px;
            width: 62px;
            height: 24px;
            visible: root.shelf-action-3-visible;
            text: root.shelf-action-3;
            clicked => { root.shelf-action-clicked(2); }
        }

        Button {
            x: 210px;
            y: 30px;
            width: 62px;
            height: 24px;
            visible: root.shelf-action-4-visible;
            text: root.shelf-action-4;
            clicked => { root.shelf-action-clicked(3); }
        }

        Button {
            x: 278px;
            y: 30px;
            width: 62px;
            height: 24px;
            visible: root.shelf-action-5-visible;
            text: root.shelf-action-5;
            clicked => { root.shelf-action-clicked(4); }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    in property <image> tray-image;
    callback show-shell-requested();
    callback show-pet-requested();
    callback hide-pet-requested();
    callback quit-requested();

    icon: root.tray-image;
    title: "NovaHub";
    tooltip: "NovaHub";
    visible: true;

    Menu {
        MenuItem {
            title: "Show NovaHub";
            activated => { root.show-shell-requested(); }
        }
        MenuItem {
            title: "Show Pet";
            activated => { root.show-pet-requested(); }
        }
        MenuItem {
            title: "Hide Pet";
            activated => { root.hide-pet-requested(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit NovaHub";
            activated => { root.quit-requested(); }
        }
    }
}
